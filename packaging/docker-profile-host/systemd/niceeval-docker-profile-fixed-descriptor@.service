[Unit]
Description=NiceEval fixed-image activation descriptor verifier (%i)
After=niceeval-docker-profile-fixed-images@%i.service
Requires=niceeval-docker-profile-fixed-images@%i.service
Before=niceeval-docker-profile-fixed-watchdog@%i.service
ConditionPathExists=/etc/niceeval/docker-profiles/%i.fixed-image-v1.host.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/niceeval/activate-fixed-images --host-config=/etc/niceeval/docker-profiles/%i.fixed-image-v1.host.json --descriptor=/etc/niceeval/docker-profiles/%i.json --verify-only

[Install]
WantedBy=multi-user.target
