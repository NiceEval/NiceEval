[Unit]
Description=NiceEval fixed-image backing attestation (%i)
After=local-fs.target docker.service
Requires=docker.service niceeval-docker-profile-%i.slice
Before=niceeval-docker-profile-fixed-descriptor@%i.service niceeval-docker-profile-fixed-watchdog@%i.service
ConditionPathExists=/etc/niceeval/docker-profiles/%i.fixed-image-v1.host.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/niceeval/activate-fixed-images --host-config=/etc/niceeval/docker-profiles/%i.fixed-image-v1.host.json --descriptor=/etc/niceeval/docker-profiles/%i.json --boot-restore --systemd-drop-in-root=/run/systemd/system --systemd-watchdog-unit=niceeval-docker-profile-fixed-watchdog@%i.service --reload-systemd

[Install]
WantedBy=multi-user.target
