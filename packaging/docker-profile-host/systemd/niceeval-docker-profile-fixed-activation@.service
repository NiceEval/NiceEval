[Unit]
Description=NiceEval exclusive fixed-image backing activation (%i)
After=local-fs.target docker.service
Requires=docker.service niceeval-docker-profile-%i.slice
Before=niceeval-docker-profile-fixed-images@%i.service niceeval-docker-profile-fixed-descriptor@%i.service niceeval-docker-profile-fixed-watchdog@%i.service
Conflicts=niceeval-docker-profile-watchdog@%i.service niceeval-docker-profile-watchdog@%i.socket niceeval-docker-profile-fixed-watchdog@%i.service
ConditionPathExists=/etc/niceeval/docker-profiles/%i.fixed-image-v1.host.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/niceeval/activate-fixed-images --host-config=/etc/niceeval/docker-profiles/%i.fixed-image-v1.host.json --descriptor=/etc/niceeval/docker-profiles/%i.json --access-group=niceeval-dp-%i-access --inactive-unit=niceeval-docker-profile-watchdog@%i.service --inactive-unit=niceeval-docker-profile-fixed-watchdog@%i.service --prepare-store --prepare-helper=/usr/libexec/niceeval/prepare-loop-storage --systemd-drop-in-root=/run/systemd/system --systemd-watchdog-unit=niceeval-docker-profile-fixed-watchdog@%i.service --reload-systemd

# Deliberately no [Install]: this is an explicit deployment transaction, not
# part of the steady-state boot transaction.
