# 本地 E2E 的唯一环境变量入口。复制为仓库根目录的 .env；根 runner 只把
# 每个 e2e.json 明确声明的 secret 注入对应隔离场景。

# AI SDK（OpenAI-compatible）
OPENAI_API_KEY=
OPENAI_BASE_URL=
NICEEVAL_JUDGE_KEY=

# Bub；Hermes、OpenClaw 与 OpenCode 的 live E2E 复用同一兼容网关。
BUB_API_KEY=
BUB_API_BASE=

# Claude Code。填网关根地址，不要追加 /v1；CLI 会自行请求 /v1/messages。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Codex CLI（OpenAI-compatible）
CODEX_API_KEY=
CODEX_BASE_URL=

# 可选：使用宿主已经安装的 Chromium。留空时使用 Playwright 管理的浏览器。
CHROMIUM_EXECUTABLE_PATH=
