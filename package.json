{
  "name": "niceeval-workspace",
  "private": true,
  "nx": {
    "includedScripts": []
  },
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "pnpm --filter @niceeval/repo-tools run typecheck && pnpm --filter niceeval run typecheck && pnpm --filter niceeval exec tsc -p ../../docs/feature/assertions/reference/tsconfig.json",
    "lint": "pnpm run docs:mint && concurrently --names vitest,validate,links \"pnpm run lint:vitest\" \"pnpm run docs:validate\" \"pnpm run docs:links\"",
    "lint:vitest": "vitest run --project lint-docs --project lint-docs-site",
    "lint:docs": "vitest run --project lint-docs",
    "lint:docs-site": "pnpm run docs:mint && concurrently --names vitest,validate,links \"vitest run --project lint-docs-site\" \"pnpm run docs:validate\" \"pnpm run docs:links\"",
    "niceeval": "node packages/niceeval/bin/niceeval.js",
    "e2e": "tsx e2e/scripts/cli.ts",
    "feedback": "tsx packages/repo-tools/src/cli.ts feedback",
    "memory": "tsx packages/repo-tools/src/cli.ts memory",
    "pr:body": "tsx packages/repo-tools/src/cli.ts pr body",
    "docs:terms": "tsx packages/repo-tools/src/cli.ts docs terms",
    "docs:work": "tsx packages/repo-tools/src/cli.ts docs work",
    "docs:diff-code": "tsx packages/repo-tools/src/cli.ts docs diff-code",
    "docs:reference": "tsx packages/repo-tools/src/cli.ts docs reference",
    "examples:sync": "tsx packages/repo-tools/src/cli.ts examples sync",
    "consumer:link": "tsx packages/repo-tools/src/cli.ts consumer link",
    "repo:setup": "tsx packages/repo-tools/src/cli.ts repository setup",
    "view:build": "pnpm --filter niceeval run view:build",
    "build:report": "pnpm --filter niceeval run build:report",
    "build:package": "pnpm --filter niceeval run build:package",
    "build:index": "tsx packages/repo-tools/src/cli.ts consumer bundled-index",
    "prepare": "pnpm repo:setup apply",
    "site:dev": "pnpm --filter niceeval run build:package && pnpm --filter @niceeval/site run dev",
    "site:build": "pnpm --filter niceeval run build:package && pnpm --filter @niceeval/site run build:deploy",
    "docs:dev": "tsx packages/repo-tools/src/cli.ts docs dev",
    "docs:mint": "cd apps/docs-site && npx --yes mint@4.2.812 --version",
    "docs:validate": "cd apps/docs-site && npx --yes mint@4.2.812 validate",
    "docs:links": "cd apps/docs-site && npx --yes mint@4.2.812 broken-links --check-anchors --check-redirects"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/tar-stream": "^3.1.3",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "ignore": "7.0.5",
    "next": "16.3.0",
    "nx": "23.1.1",
    "tar-stream": "^3.1.7",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
