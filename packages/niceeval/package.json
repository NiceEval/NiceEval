{
  "name": "niceeval",
  "version": "0.0.0-development",
  "description": "Agent-native eval tool — eval agents, services, functions, and coding-agent fixtures",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiceEval/NiceEval.git"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "niceeval": "bin/niceeval.js"
  },
  "exports": {
    ".": {
      "niceeval-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./judge": {
      "niceeval-source": "./src/judge/index.ts",
      "types": "./dist/judge/index.d.ts",
      "default": "./dist/judge/index.js"
    },
    "./sandbox": {
      "niceeval-source": "./src/sandbox/index.ts",
      "types": "./dist/sandbox/index.d.ts",
      "default": "./dist/sandbox/index.js"
    },
    "./sandbox/e2b-template": {
      "niceeval-source": "./src/sandbox/e2b-agent-template.ts",
      "types": "./dist/sandbox/e2b-agent-template.d.ts",
      "default": "./dist/sandbox/e2b-agent-template.js"
    },
    "./adapter": {
      "niceeval-source": "./src/agents/index.ts",
      "types": "./dist/agents/index.d.ts",
      "default": "./dist/agents/index.js"
    },
    "./adapter/otel": {
      "niceeval-source": "./src/agents/ai-sdk-otel.ts",
      "types": "./dist/agents/ai-sdk-otel.d.ts",
      "default": "./dist/agents/ai-sdk-otel.js"
    },
    "./plugin": {
      "niceeval-source": "./src/plugin/index.ts",
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./expect": {
      "niceeval-source": "./src/expect/index.ts",
      "types": "./dist/expect/index.d.ts",
      "default": "./dist/expect/index.js"
    },
    "./reporters": {
      "niceeval-source": "./src/runner/reporters/index.ts",
      "types": "./dist/runner/reporters/index.d.ts",
      "default": "./dist/runner/reporters/index.js"
    },
    "./loaders": {
      "niceeval-source": "./src/loaders/index.ts",
      "types": "./dist/loaders/index.d.ts",
      "default": "./dist/loaders/index.js"
    },
    "./eval/host": {
      "niceeval-source": "./src/eval/host/index.ts",
      "types": "./dist/eval/host/index.d.ts",
      "default": "./dist/eval/host/index.js"
    },
    "./experiment/host": {
      "niceeval-source": "./src/experiment/host/index.ts",
      "types": "./dist/experiment/host/index.d.ts",
      "default": "./dist/experiment/host/index.js"
    },
    "./coordination/host": {
      "niceeval-source": "./src/coordination/host/index.ts",
      "types": "./dist/coordination/host/index.d.ts",
      "default": "./dist/coordination/host/index.js"
    },
    "./run/host": {
      "niceeval-source": "./src/run/host/index.ts",
      "types": "./dist/run/host/index.d.ts",
      "default": "./dist/run/host/index.js"
    },
    "./run": {
      "niceeval-source": "./src/run/index.ts",
      "types": "./dist/run/index.d.ts",
      "default": "./dist/run/index.js"
    },
    "./inspection": {
      "niceeval-source": "./src/inspection/public.ts",
      "types": "./dist/inspection/public.d.ts",
      "default": "./dist/inspection/public.js"
    },
    "./view": {
      "niceeval-source": "./src/view/index.ts",
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    },
    "./project/host": {
      "niceeval-source": "./src/project/host/index.ts",
      "types": "./dist/project/host/index.d.ts",
      "default": "./dist/project/host/index.js"
    }
  },
  "files": [
    "INDEX.md",
    "bin",
    "dist",
    "docs-site/zh",
    "docs-site/images"
  ],
  "bundledDependencies": [
    "@effect/platform-node",
    "@effect/platform-node-shared",
    "@types/ws",
    "effect",
    "fast-check",
    "mime",
    "msgpackr",
    "pure-rand",
    "undici",
    "ws"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "niceeval": "node bin/niceeval.js",
    "sync:prices": "node scripts/sync-prices.mjs",
    "check:prices": "node scripts/sync-prices.mjs --check",
    "build:package": "node scripts/package-runtime/build.mjs",
    "build:index": "pnpm --dir ../.. run build:index",
    "stage:docs": "node docs-source/stage-docs.mjs",
    "prepack": "pnpm exec concurrently --kill-others-on-fail --names package,index,docs \"pnpm run build:package\" \"pnpm run build:index\" \"pnpm run stage:docs\""
  },
  "dependencies": {
    "effect": "4.1.3",
    "jiti": "2.7.0",
    "openai": "^7.53.0",
    "oxc-parser": "0.158.0",
    "tar-stream": "3.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ai-sdk/otel": "^1.0.166",
    "@alibaba-group/opensandbox": "1.2.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@effect/platform-node": "4.1.3",
    "@effect/platform-node-shared": "4.1.3",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@playwright/test": "1.65.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@standard-schema/spec": "1.1.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vercel/sandbox": "3.9.1",
    "@vitejs/plugin-react": "^6.3.0",
    "braintrust": "^3.43.0",
    "concurrently": "^10.0.7",
    "dockerode": "^5.0.1",
    "e2b": "^2.63.0",
    "effect": "4.1.3",
    "fast-check": "4.10.2",
    "husky": "^9.1.7",
    "i18next": "^27.0.1",
    "mime": "4.1.2",
    "msgpackr": "2.1.4",
    "pure-rand": "8.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "recharts": "3.10.1",
    "ssh2": "1.17.0",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "undici": "8.12.4",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "ws": "8.22.2"
  },
  "peerDependencies": {
    "@ai-sdk/otel": ">=1.0.0",
    "@alibaba-group/opensandbox": "^1.1.1",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.200.0",
    "@opentelemetry/sdk-trace-node": ">=2.0.0",
    "@vercel/sandbox": ">=2.0.0",
    "ai": ">=5.0.0",
    "braintrust": ">=0.0.150",
    "dockerode": ">=4.0.0",
    "e2b": ">=2.0.0",
    "ssh2": "1.17.0",
    "@earendil-works/pi-coding-agent": "1.5.2"
  },
  "peerDependenciesMeta": {
    "@alibaba-group/opensandbox": {
      "optional": true
    },
    "@ai-sdk/otel": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "braintrust": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "dockerode": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
