{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": false,
    "declaration": false,
    "declarationMap": false,
    "outDir": "dist/cjs",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["test"]
}
