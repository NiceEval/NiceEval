{
  "schemaVersion": 2,
  "id": "migrate",
  "batch": "host-1",
  "areas": ["record"],
  "lanes": ["pr", "main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "run", "e2e"],
  "timeoutMinutes": 2,
  "harness": { "testkit": true },
  "secrets": [],
  "requires": { "externalNetwork": false, "runtimes": ["node>=24"] },
  "paths": ["e2e/migrate/**", "src/record/**", "src/show/**", "src/cli/**", "e2e/scripts/**"],
  "artifacts": [".e2e-artifacts/**", "junit.xml"]
}
