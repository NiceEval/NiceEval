{
  "schemaVersion": 2,
  "id": "adapter/codex-cli",
  "batch": "docker-2",
  "areas": ["adapter", "sandbox"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "exec", "vitest", "run"],
  "timeoutMinutes": 3,
  "harness": { "testkit": true },
  "secrets": ["OPENAI_API_KEY", "OPENAI_BASE_URL"],
  "requires": { "docker": true, "externalNetwork": true, "runtimes": ["node>=24"] },
  "paths": [
    "e2e/adapter/codex-cli/**",
    "src/agents/codex-app-server.ts",
    "src/agents/codex.ts",
    "src/o11y/parsers/codex.ts",
    "package.json",
    "pnpm-lock.yaml",
    "e2e/scripts/**"
  ],
  "artifacts": [".niceeval/**", "junit.xml"]
}
