{
  "schemaVersion": 1,
  "id": "adapter/codex-cli",
  "areas": ["adapter", "sandbox"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "e2e"],
  "timeoutMinutes": 40,
  "secrets": ["CODEX_API_KEY", "CODEX_BASE_URL", "NICEEVAL_JUDGE_KEY", "NICEEVAL_JUDGE_BASE"],
  "requires": { "docker": true, "externalNetwork": true },
  "paths": ["e2e/adapter/codex-cli/**", "package.json", "pnpm-lock.yaml", "e2e/scripts/**"],
  "artifacts": [".niceeval/**", "junit.xml"]
}
