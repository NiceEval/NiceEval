{
  "schemaVersion": 1,
  "id": "adapter/claude-code",
  "areas": ["adapter", "sandbox"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "exec", "vitest", "run"],
  "timeoutMinutes": 40,
  "harness": { "testkit": true, "adapterAssertions": true },
  "secrets": ["ANTHROPIC_API_KEY", "ANTHROPIC_BASE_URL"],
  "requires": { "runtimes": ["node>=22"], "docker": true, "externalNetwork": true },
  "paths": ["e2e/adapter/claude-code/**", "e2e/adapter/shared/**", "package.json", "pnpm-lock.yaml", "e2e/scripts/**"],
  "artifacts": [".niceeval/**", "junit.xml"]
}
