{
  "schemaVersion": 2,
  "id": "adapter/openai-compat",
  "batch": "host-1",
  "areas": ["adapter"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "run", "e2e"],
  "timeoutMinutes": 3,
  "harness": { "testkit": true },
  "secrets": ["OPENAI_API_KEY", "OPENAI_BASE_URL"],
  "requires": { "externalNetwork": true, "runtimes": ["node>=22"] },
  "paths": ["e2e/adapter/openai-compat/**", "src/agents/openai-compat.ts", "package.json", "pnpm-lock.yaml", "e2e/scripts/**"],
  "artifacts": [".e2e-artifacts/**", "junit/**"]
}
