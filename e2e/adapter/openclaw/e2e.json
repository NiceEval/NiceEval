{
  "schemaVersion": 2,
  "id": "adapter/openclaw",
  "batch": "docker-1",
  "areas": ["adapter", "sandbox"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "exec", "vitest", "run"],
  "timeoutMinutes": 2,
  "harness": { "testkit": true },
  "secrets": ["BUB_API_KEY", "BUB_API_BASE"],
  "requires": { "docker": true, "externalNetwork": true },
  "paths": ["e2e/adapter/openclaw/**", "package.json", "pnpm-lock.yaml", "e2e/scripts/**"],
  "artifacts": [".niceeval/**", "junit.xml"]
}
