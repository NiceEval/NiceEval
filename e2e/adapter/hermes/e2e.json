{
  "schemaVersion": 1,
  "id": "adapter/hermes",
  "areas": ["adapter", "sandbox"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "e2e"],
  "timeoutMinutes": 40,
  "secrets": [
    "BUB_API_KEY",
    "BUB_API_BASE"
  ],
  "requires": {
    "docker": true
  },
  "paths": ["e2e/adapter/hermes/**", "package.json", "pnpm-lock.yaml", "e2e/scripts/**"],
  "artifacts": [
    ".niceeval/**",
    "junit.xml",
    "logs/**"
  ]
}
