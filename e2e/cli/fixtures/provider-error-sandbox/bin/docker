    ;;
  *)
    printf '%s\n' '502 Bad Gateway · DOCKER_PROVIDER_TIMEOUT: the primary sandbox builder could not reach unix:///fixture/docker.sock; this deliberately long safe explanation repeats context context context context context context context context context context context context context context context context context context context context; request req_docker_primary_789' >&2
    ;;
