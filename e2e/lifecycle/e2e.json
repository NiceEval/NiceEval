{
  "schemaVersion": 2,
  "id": "lifecycle",
  "batch": "docker-3",
  "areas": ["lifecycle"],
  "lanes": ["pr", "main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "exec", "vitest", "run"],
  "timeoutMinutes": 2,
  "harness": { "testkit": true },
  "secrets": [],
  "requires": { "runtimes": ["node>=24"], "docker": true },
  "paths": [
    "e2e/lifecycle/**",
    "src/cli.ts",
    "src/define.ts",
    "src/index.ts",
    "src/runner/**",
    "src/agents/**",
    "src/sandbox/**"
  ],
  "artifacts": [".niceeval/**"]
}
