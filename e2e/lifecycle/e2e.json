{
  "schemaVersion": 2,
  "id": "lifecycle",
  "batch": "docker-3",
  "areas": ["lifecycle"],
  "lanes": ["pr", "main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["python3", "fixtures/subreaper-runner.py", "pnpm", "exec", "vitest", "run"],
  "timeoutMinutes": 2,
  "harness": { "testkit": true },
  "secrets": [],
  "requires": {
    "runtimes": ["node>=24", "python>=3.11"],
    "docker": true,
    "platforms": ["linux"]
  },
  "paths": [
    "e2e/lifecycle/**",
    "packages/niceeval/src/cli.ts",
    "packages/niceeval/src/define.ts",
    "packages/niceeval/src/index.ts",
    "packages/niceeval/src/runner/**",
    "packages/niceeval/src/agents/**",
    "packages/niceeval/src/sandbox/**"
  ],
  "artifacts": [".niceeval/**"]
}
