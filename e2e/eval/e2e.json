{
  "schemaVersion": 2,
  "id": "eval",
  "batch": "host-3",
  "areas": ["eval"],
  "lanes": ["pr", "main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "exec", "vitest", "run"],
  "timeoutMinutes": 2,
  "harness": { "testkit": true },
  "secrets": [],
  "requires": { "runtimes": ["node>=24"] },
  "paths": [
    "e2e/eval/**",
    "packages/niceeval/src/context/**",
    "packages/niceeval/src/assertions/**",
    "packages/niceeval/src/expect/**",
    "packages/niceeval/src/agents/**",
    "packages/niceeval/src/sandbox/**",
    "packages/niceeval/src/runner/**",
    "packages/niceeval/src/record/**"
  ],
  "artifacts": [".e2e-artifacts/**"]
}
