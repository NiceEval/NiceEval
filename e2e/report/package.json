{
  "name": "niceeval-e2e-report",
  "version": "0.1.0",
  "private": true,
  "nx": {
    "includedScripts": []
  },
  "type": "module",
  "description": "Report E2E consumer: public show/view/export and one browser journey",
  "scripts": {
    "e2e": "vitest run && playwright test",
    "test": "node -e \"console.error('场景目录不是正式测试入口：请从仓库根运行 pnpm e2e test --repo report'); process.exit(1)\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "effect": "3.22.1",
    "niceeval": "^0.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
