import { defineExperiment } from "niceeval";
import { deterministicAgent } from "../agents/deterministic.ts";

export default defineExperiment({
  description: "classic-companion:用不均匀 Attempt 数证明 passRate 按 Eval 等权",
  agent: deterministicAgent("report-fixture-companion", 0.01),
  model: "report-fixture-v1",
  labels: { line: "codex" },
  flags: { memory: "baseline" },
  attempts: 3,
  maxConcurrency: 1,
  evals: ["deliberate-fail"],
});
