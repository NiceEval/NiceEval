{
  "id": "report",
  "group": "report",
  "command": [
    "pnpm",
    "e2e"
  ],
  "timeoutMinutes": 15,
  "harness": {
    "testkit": true
  },
  "secrets": [
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL"
  ],
  "artifacts": [
    ".e2e-artifacts/**",
    "test-results/**",
    ".niceeval/**",
    "site-export/**",
    "main.xml",
    "fail.xml",
    "error.xml",
    "main.ndjson",
    "logs/**"
  ],
  "requires": {
    "runtimes": [
      "node>=22"
    ]
  }
}
