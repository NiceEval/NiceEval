{
  "schemaVersion": 2,
  "id": "plugins",
  "batch": "docker-3",
  "areas": ["lifecycle"],
  "lanes": ["pr", "main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "exec", "vitest", "run"],
  "timeoutMinutes": 2,
  "harness": { "testkit": true },
  "secrets": [],
  "requires": { "runtimes": ["node>=24"], "docker": true },
  "paths": [
    "e2e/plugins/**",
    "packages/niceeval/src/plugin/**",
    "packages/niceeval/src/define.ts",
    "packages/niceeval/src/index.ts",
    "packages/niceeval/src/runner/**",
    "packages/niceeval/src/sandbox/**"
  ],
  "artifacts": [".niceeval/**", "plugin-lifecycle.ndjson"]
}
