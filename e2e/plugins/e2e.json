{
  "schemaVersion": 2,
  "id": "plugins",
  "batch": "docker-1",
  "areas": ["lifecycle"],
  "lanes": ["pr", "main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "exec", "vitest", "run"],
  "timeoutMinutes": 10,
  "harness": { "testkit": true },
  "secrets": [],
  "requires": { "runtimes": ["node>=22"], "docker": true },
  "paths": [
    "e2e/plugins/**",
    "src/plugin/**",
    "src/define.ts",
    "src/index.ts",
    "src/runner/**",
    "src/sandbox/**"
  ],
  "artifacts": [".niceeval/**", "plugin-lifecycle.ndjson"]
}
