{
  "schemaVersion": 1,
  "id": "codex-sdk",
  "areas": ["adapter"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "e2e"],
  "timeoutMinutes": 20,
  "secrets": ["CODEX_API_KEY", "CODEX_BASE_URL", "AGENT_MODEL", "NICEEVAL_JUDGE_KEY", "NICEEVAL_JUDGE_BASE"],
  "paths": ["e2e/undo/codex-sdk/**", "package.json", "pnpm-lock.yaml", "e2e/scripts/**"],
  "artifacts": [".niceeval/**", "junit.xml", "logs/**"]
}
