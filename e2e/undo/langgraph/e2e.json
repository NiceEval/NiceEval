{
  "schemaVersion": 1,
  "id": "langgraph",
  "areas": ["adapter"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "e2e"],
  "timeoutMinutes": 15,
  "secrets": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "AGENT_MODEL", "NICEEVAL_JUDGE_KEY", "NICEEVAL_JUDGE_BASE"],
  "requires": { "runtimes": ["node>=22", "python>=3.11"] },
  "paths": ["e2e/undo/langgraph/**", "package.json", "pnpm-lock.yaml", "e2e/scripts/**"],
  "artifacts": [".niceeval/**", "junit.xml", "logs/**"]
}
