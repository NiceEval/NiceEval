{
  "schemaVersion": 1,
  "id": "claude-agent-sdk",
  "areas": ["adapter"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "e2e"],
  "timeoutMinutes": 20,
  "secrets": ["ANTHROPIC_API_KEY", "ANTHROPIC_BASE_URL", "AGENT_MODEL", "NICEEVAL_JUDGE_KEY", "NICEEVAL_JUDGE_BASE"],
  "requires": { "runtimes": ["node>=22"] },
  "paths": ["e2e/undo/claude-agent-sdk/**", "package.json", "pnpm-lock.yaml", "e2e/scripts/**"],
  "artifacts": [".niceeval/**", "junit.xml", "logs/**"]
}
