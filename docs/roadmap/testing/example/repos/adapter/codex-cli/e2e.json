{
  "schemaVersion": 1,
  "id": "adapter/codex-cli",
  "areas": ["adapter", "sandbox"],
  "lanes": ["main", "nightly", "release"],
  "executor": { "kind": "host" },
  "command": ["pnpm", "test"],
  "timeoutMinutes": 40,
  "secrets": ["CODEX_API_KEY", "CODEX_BASE_URL"],
  "requires": { "docker": true, "runtimes": ["node>=22"] },
  "paths": [
    "src/agents/codex.ts",
    "src/o11y/parsers/codex.ts",
    "src/o11y/otlp/mappers/codex.ts",
    "src/sandbox/**"
  ],
  "artifacts": [".niceeval/**", "junit.xml"]
}
