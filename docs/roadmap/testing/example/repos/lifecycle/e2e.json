{
  "schemaVersion": 1,
  "id": "lifecycle",
  "areas": [
    "runner",
    "sandbox",
    "lifecycle"
  ],
  "lanes": [
    "main",
    "nightly",
    "release"
  ],
  "executor": {
    "kind": "host"
  },
  "command": [
    "pnpm",
    "test"
  ],
  "timeoutMinutes": 8,
  "secrets": [],
  "requires": {
    "runtimes": ["node>=22"]
  },
  "paths": [
    "src/cli.ts",
    "src/runner/**",
    "src/agents/**"
  ],
  "artifacts": [
    ".niceeval/**",
    "junit.xml"
  ]
}
