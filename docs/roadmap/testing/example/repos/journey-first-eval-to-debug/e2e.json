{
  "schemaVersion": 1,
  "id": "journey-first-eval-to-debug",
  "areas": [
    "cli",
    "report"
  ],
  "lanes": [
    "pr",
    "main",
    "release"
  ],
  "executor": {
    "kind": "host"
  },
  "command": [
    "pnpm",
    "test"
  ],
  "timeoutMinutes": 8,
  "secrets": [],
  "requires": {
    "runtimes": ["node>=22"],
    "browsers": ["chromium"]
  },
  "paths": [
    "src/cli.ts",
    "src/runner/**",
    "src/show/**",
    "src/view/**",
    "src/report/**"
  ],
  "artifacts": [
    ".niceeval/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
