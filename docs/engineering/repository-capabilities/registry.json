  "workflows": [
    {
      "id": "docs-terminology",
      "script": "docs:terms",
      "skill": ".agents/skills/docs-terminology/SKILL.md",
      "implementations": [
        "packages/repo-tools/src/cli.ts",
        "packages/repo-tools/src/docs-terms.ts",
        "packages/repo-tools/src/docs-writing-lint.ts",
        "docs/writing-rules.json"
      ],
      "guards": [
        "lint/docs/docs-writing.lint.ts",
        "lint/docs/repository-capabilities.lint.ts"
      ]
    },
    {
      "id": "friction-log",
      "script": "frog",
      "skill": ".agents/skills/frog/SKILL.md",
      "implementations": [
        "packages/repo-tools/package.json",
        ".agents/friction-log/README.md",
        ".agents/friction-log/config.json"
      ],
      "guards": [
        "lint/docs/repository-capabilities.lint.ts"
      ]
    },
    {
      "id": "pull-request-body",
      "script": "pr:body",
      "skill": ".agents/skills/pull-request/SKILL.md",
      "implementations": [
        "packages/repo-tools/src/cli.ts",
        "packages/repo-tools/src/pr-body.ts",
        ".github/PULL_REQUEST_TEMPLATE.md"
      ],
      "guards": [
        "lint/docs/repository-capabilities.lint.ts"
      ]
    },
    {
      "id": "repository-capabilities",
      "script": "repo:capabilities",
      "implementations": [
        "packages/repo-tools/src/cli.ts",
        "packages/repo-tools/src/repository-capabilities.ts",
        "docs/engineering/repository-capabilities/registry.json"
      ],
      "guards": [
        "lint/docs/repository-capabilities.lint.ts"
      ]
    }
  ]
}
